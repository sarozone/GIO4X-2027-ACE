# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin for this environment (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://www.gio4x.com
# "production" enables indexing. Anything else serves noindex and a disallow-all robots.txt.
NEXT_PUBLIC_SITE_ENV=development

# ── Supabase (project wcdhqykhvnlxozayeolt) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://wcdhqykhvnlxozayeolt.supabase.co
# Publishable key. Safe for the browser: row-level security is the control.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Version label of the Privacy Policy published at /legal/privacy. Stored with each
# consent record; "unversioned" is recorded when empty.
PRIVACY_POLICY_VERSION=

# ── Client / IB portal (the portal/ folder), served by this site at /portal ──
# Address of the portal's own deployment; this site proxies /portal to it.
# https only (http://localhost:3100 is accepted for local development).
# Production value is in netlify.toml. Empty = portal not connected.
PORTAL_ORIGIN=

# The portal's database, read on the server by Control's portal sections
# (KYC, Funds, Trade Log, ...). The URL is public; the key is a SECRET: it
# bypasses the portal's row-level security. Hosting environment only, never
# committed, never NEXT_PUBLIC_. Empty = those sections say "not connected".
PORTAL_SUPABASE_URL=
PORTAL_SUPABASE_SECRET_KEY=

# The trading terminal's database (per-symbol settings, trading blocks), read
# and changed by Control's Broker Controls. The same two values the portal's
# deployment has. The key is a SECRET: hosting environment only.
RAPTOR_BRIDGE_URL=
RAPTOR_BRIDGE_SERVICE_KEY=

# Outgoing service e-mail from Control's Bulk Emailer (Resend). The key is a
# SECRET. RESEND_FROM_EMAIL must be on a domain verified with the provider.
# Empty = the composer says sending is not set up; nothing is queued.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
RESEND_REPLY_TO=
# Where a copy of each enquiry and support request is sent once the four values
# above are set. Default: info@gio4x.com.
CONTACT_INBOX=

# ── Portal gateway overrides: only to send a destination somewhere else ──────
# Each must be https and on gio4x.com or a host listed in NEXT_PUBLIC_OFFICIAL_PORTAL_HOSTS.
CLIENT_PORTAL_URL=
TRADER_PORTAL_URL=
IB_PORTAL_URL=
ACCOUNT_OPENING_URL=
NEXT_PUBLIC_OFFICIAL_PORTAL_HOSTS=

# ── GIO4X AI: the assistant in the Lens panel. The site works fully without it ─
# See docs/AI.md. The assistant answers only when BOTH are true: the switch is
# exactly "true" and the key is present. Anything else: /api/ai answers 503,
# the Lens shows no "Ask" tab and /trust/ai says "Not live".
# The switch and the model name are written into the build (next.config.mjs),
# so changing either needs a redeploy; /trust/ai changes in the same deploy.
GIO4X_AI_ENABLED=
# The provider key is a SECRET: hosting environment only (it must be available
# to Functions at run time), never committed, never NEXT_PUBLIC_.
# On Netlify use GIO4X_ANTHROPIC_API_KEY: the host injects its own ANTHROPIC_API_KEY
# (its AI gateway), which the provider refuses. GIO4X_ANTHROPIC_API_KEY wins when both are set.
GIO4X_ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY=
# claude-haiku-4-5 (the default when empty), claude-sonnet-5-5 or claude-opus-5-5.
# Anything else falls back to the default.
GIO4X_AI_MODEL=
# The limits (questions a minute and a day, answer length, passages sent) are
# not environment variables: they are AI_LIMITS in src/lib/ai.ts.

# ── Search engine verification (optional) ────────────────────────────────────
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
